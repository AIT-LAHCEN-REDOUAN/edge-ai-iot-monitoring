\chapter{Chaîne de Markov en Temps Discret (DTMC)}
\onehalfspacing

\section*{Objectifs}
\begin{itemize}[leftmargin=1.5em]
  \item Formaliser la dynamique des états discrets \( \{L, M, H, P\} \) par une DTMC.
  \item Définir et calculer la \textbf{distribution stationnaire} \( \pi \) telle que \( \pi P = \pi \).
  \item Simuler des trajectoires futures et \textbf{prévoir} \( \pi_t \) par itération \( \pi_{t+1}=\pi_t P \).
\end{itemize}

\section*{Définitions mathématiques}
Soit une chaîne \((X_t)_{t\geq 0}\) à espace d’états fini \(\mathcal{S}=\{L,M,H,P\}\) et matrice de transitions \(P\in\mathbb{R}^{4\times 4}\).
\begin{itemize}[leftmargin=1.5em]
  \item \textbf{Propriété de Markov} : \(\Pr(X_{t+1}=j\mid X_t=i, X_{t-1},\ldots)=\Pr(X_{t+1}=j\mid X_t=i)=P(i\to j)\).
  \item \textbf{Stochasticité des lignes} : \(\sum_{j\in\mathcal{S}} P(i\to j)=1\) pour tout \(i\).
  \item \textbf{Transitions à \(n\) pas} : \(P^{(n)} = P^n\) (formule de Chapman–Kolmogorov).
  \item \textbf{Distribution à l’instant \(t\)} : \(\pi_t\in\Delta(\mathcal{S})\) vérifie \(\pi_{t+1}=\pi_t P\).
\end{itemize}

\section*{Stationnarité, ergodicité et convergence}
\begin{itemize}[leftmargin=1.5em]
  \item \textbf{Distribution stationnaire} : \( \pi\in\Delta(\mathcal{S}) \) telle que \( \pi P = \pi \) (vecteur propre gauche associé à \( \lambda=1 \)).
  \item \textbf{Ergodicité} (finie) : si la chaîne est \textit{irréductible} (tous les états communiquent) et \textit{apériodique}, alors \( \pi \) existe, est unique et \(\pi_t\to \pi\).
  \item \textbf{Retour moyen} : pour un état \(i\) récurrent positif, \( \mathbb{E}_i[T_i^+] = 1/\pi_i\).
  \item \textbf{Mélange} : la vitesse de convergence dépend du \textit{SLEM} \(|\lambda_2|\) (\(\lambda_1=1\ge|\lambda_2|\ge\cdots\)); grand \((1-|\lambda_2|)\) \(\Rightarrow\) mélange rapide.
\end{itemize}

