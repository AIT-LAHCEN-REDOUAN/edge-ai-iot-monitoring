\chapter{Modèles de Markov Cachés (HMM)}
\onehalfspacing

\section*{Objectifs}
\begin{itemize}[leftmargin=1.5em]
  \item Modéliser des \textbf{modes cachés} de fonctionnement expliquant les observations \(\{L,M,H,P\}\).
  \item Estimer \(\lambda=(A,B,\pi_0)\) par \textbf{Baum–Welch} (EM) et décoder par \textbf{Viterbi}.
  \item Délivrer des matrices \(A\) (transitions) et \(B\) (émissions) interprétables.
\end{itemize}

\section*{Définition du HMM}
Paramètres \(\lambda=(A,B,\pi_0)\) :
\begin{itemize}[leftmargin=1.5em]
  \item \(A[i,j]=\Pr(s_{t+1}=j\mid s_t=i)\) (stochastique par ligne),
  \item \(B[i,o]=\Pr(o_t=o\mid s_t=i)\) pour \(o\in\{L,M,H,P\}\),
  \item \(\pi_0[i]=\Pr(s_0=i)\).
\end{itemize}
Vraisemblance : \(P(\mathbf{O}\mid\lambda)=\sum_{\mathbf{s}}P(\mathbf{O},\mathbf{s}\mid\lambda)\).

\section*{Forward–Backward (mise à l’échelle)}
\[
\alpha_0(i)=\pi_0[i]\,B[i,o_0],\quad
\alpha_{t+1}(j)=\Bigl[\sum_{i}\alpha_t(i)\,A[i,j]\Bigr]B[j,o_{t+1}],
\]
\[
\beta_T(i)=1,\quad
\beta_t(i)=\sum_j A[i,j]\,B[j,o_{t+1}]\,\beta_{t+1}(j).
\]
Facteurs d’échelle (ou espace log) utilisés pour la stabilité numérique.

\section*{Viterbi (décodage)}
\[
\delta_0(i)=\log \pi_0[i]+\log B[i,o_0],\quad
\delta_{t+1}(j)=\max_i\bigl(\delta_t(i)+\log A[i,j]\bigr)+\log B[j,o_{t+1}],
\]
avec \(\psi_{t+1}(j)=\arg\max_i(\cdot)\) et rétro‑propagation depuis \(s_T=\arg\max_i\delta_T(i)\).

\section*{Baum–Welch (EM)}
\(\gamma_t(i)=\Pr(s_t=i\mid\mathbf{O},\lambda)\), \(\xi_t(i,j)=\Pr(s_t=i,s_{t+1}=j\mid\mathbf{O},\lambda)\) et
\[
A[i,j]=\frac{\sum_t \xi_t(i,j)}{\sum_t \gamma_t(i)},\quad
B[i,o]=\frac{\sum_{t:o_t=o}\gamma_t(i)}{\sum_t\gamma_t(i)},\quad
\pi_0[i]=\gamma_0(i).
\]

