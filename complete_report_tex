\chapter{Prétraitement}
\onehalfspacing

\section*{Objectifs}
\begin{itemize}[leftmargin=1.5em]
  \item Construire des jeux propres et cohérents aux granularités \textbf{horaire} et \textbf{journalière}.
  \item Assurer des conversions d’unités et dérivées stables (p.\,ex. énergie \textit{Other}).
  \item Appliquer des \textbf{normalisations sûres} (z-score, min–max) qui restent définies en cas de variance nulle.
  \item Préserver la traçabilité pour les chapitres de modélisation (discrétisation, DTMC/CTMC, HMM, MDP, RL).
\end{itemize}

\section*{Conversions et dérivées}
La puissance active globale (\texttt{Global\_active\_power}) est fournie en kW par minute. L’énergie active par minute (Wh) est :
\[
  \text{active\_wh} = \text{Global\_active\_power} \times \frac{1000}{60}.
\]
L’énergie «\,Other\,» comble l’identité énergétique en complément des sous-compteurs~:
\[
  \text{Other\_wh} = \max\!\bigl(0,\ \text{active\_wh} - (\text{Sub\_metering\_1}+\text{Sub\_metering\_2}+\text{Sub\_metering\_3})\bigr).
\]

\section*{Agrégations robustes}

\subsection*{Agrégation horaire}
On agrège par heure pour construire des moyennes de puissance et des sommes d’énergie :

\begin{align*}
  \text{mean\_kW}^{(h)} &= \frac{1}{n_h}\sum_{t\in h}\text{Global\_active\_power}_t, \\
  \text{std\_kW}^{(h)}  &= \sqrt{\frac{1}{n_h-1}\sum_{t\in h}
  \Bigl(\text{Global\_active\_power}_t - \text{mean\_kW}^{(h)}\Bigr)^2}.
\end{align*}

\begin{align*}
  \text{sub1\_Wh}^{(h)} &= \sum_{t\in h}\text{Sub\_metering\_1}_t,\\
  \text{sub2\_Wh}^{(h)} &= \sum_{t\in h}\text{Sub\_metering\_2}_t,\\
  \text{sub3\_Wh}^{(h)} &= \sum_{t\in h}\text{Sub\_metering\_3}_t,\\
  \text{other\_Wh}^{(h)} &= \sum_{t\in h}\text{Other\_wh}_t.
\end{align*}

Les valeurs non numériques sont converties en \texttt{NaN} puis ignorées dans les sommes et les calculs.

\subsection*{Agrégation journalière}
Même principe au pas jour \(D\), afin d’alimenter l’EDA et la discrétisation :

\begin{align*}
  \text{mean\_kW}^{(D)} &= \frac{1}{n_D}\sum_{h\in D}\text{mean\_kW}^{(h)},\\
  \text{std\_kW}^{(D)}  &= \frac{1}{n_D}\sum_{h\in D}\text{std\_kW}^{(h)},\\
  \text{max\_kW}^{(D)}  &= \max_{h\in D}\text{max\_kW}^{(h)},\\
  \text{sub1\_Wh}^{(D)} &= \sum_{h\in D}\text{sub1\_Wh}^{(h)},\\
  \text{sub2\_Wh}^{(D)} &= \sum_{h\in D}\text{sub2\_Wh}^{(h)},\\
  \text{sub3\_Wh}^{(D)} &= \sum_{h\in D}\text{sub3\_Wh}^{(h)},\\
  \text{other\_Wh}^{(D)} &= \sum_{h\in D}\text{other\_Wh}^{(h)}.
\end{align*}

\section*{Normalisations sûres}
Deux échelles sont préparées pour les chapitres suivants :
\begin{align*}
  &\text{z-score: } z = 
  \begin{cases}
    \dfrac{x-\mu}{\sigma} & \text{si } \sigma>0,\\[4pt]
    0 & \text{sinon (variance nulle)},
  \end{cases}
  \\
  &\text{min–max: } r =
  \begin{cases}
    \dfrac{x - x_{\min}}{x_{\max}-x_{\min}} & \text{si } x_{\max}>x_{\min},\\[4pt]
    0.5 & \text{sinon (domaine nul)}.
  \end{cases}
\end{align*}
Cette logique évite les divisions par zéro et stabilise les entrées des modèles.

\section*{Contrôles de qualité}
\begin{itemize}[leftmargin=1.5em]
  \item Index temporel strictement croissant, sans doublons ; horodatages cohérents avec la granularité.
  \item Comptes d’échantillons par heure/jour (\(n_h, n_D\)) pour repérer les jours incomplets.
  \item Aucune suppression d’outliers à ce stade : le filtrage statistique intervient en EDA.
\end{itemize}

\section*{Artefacts}
Exports \textit{propres} (CSV) aux pas \textbf{horaire} et \textbf{journalière} contenant \(\text{mean\_kW}\), \(\text{std\_kW}\), \(\text{max\_kW}\), les \(\text{sub*}\_\text{Wh}\), \(\text{other\_Wh}\), ainsi que les colonnes normalisées utiles à la modélisation.

