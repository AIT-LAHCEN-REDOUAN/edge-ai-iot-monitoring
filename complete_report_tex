\chapter{Ingénierie de caractéristiques}
\onehalfspacing

\section*{Objectifs}
\begin{itemize}[leftmargin=1.5em]
  \item Définir des variables dérivées \textbf{interprétables} et \textbf{stables} pour la discrétisation, HMM, MDP et RL.
  \item Construire des \textbf{parts d’énergie} par circuit, des \textbf{ratios de charge} et des \textbf{encodages de contexte}.
  \item Garantir des formules \textbf{numériquement sûres} (gestion des divisions par zéro).
\end{itemize}

\section*{Caractéristiques dérivées (formules)}
Pour un jour \(D\), l’énergie totale est
\[
E_{\text{tot}}^{(D)}=\text{sub1\_Wh}^{(D)}+\text{sub2\_Wh}^{(D)}+\text{sub3\_Wh}^{(D)}+\text{other\_Wh}^{(D)}.
\]
Les \textbf{parts} (proportions) sont
\[
\text{share}_{k}^{(D)}=
\begin{cases}
\dfrac{\text{sub}k\_\text{Wh}^{(D)}}{E_{\text{tot}}^{(D)}} & \text{si } E_{\text{tot}}^{(D)}>0,\\[6pt]
0 & \text{sinon},
\end{cases}
\quad k\in\{1,2,3,\text{other}\}.
\]
Le \textbf{ratio de pointe} repose sur la puissance maximale journalière~:
\[
\text{peak\_ratio}^{(D)}=
\begin{cases}
\dfrac{\text{max\_kW}^{(D)}}{\text{mean\_kW}^{(D)}} & \text{si } \text{mean\_kW}^{(D)}>0,\\[6pt]
1 & \text{sinon}.
\end{cases}
\]
Enfin, le \textbf{taux de couverture horaire} est défini par
\[
\text{cov}^{(D)}=\frac{n_H^{(D)}}{24},
\]
où \(n_H^{(D)}\) est le nombre d’heures valides dans \(D\).

\section*{Encodages de contexte}
\begin{itemize}[leftmargin=1.5em]
  \item \textbf{Jour de semaine} (one-hot) : Monday\ldots Sunday.
  \item \textbf{Mois} (one-hot) : Janvier\ldots Décembre ou \(\text{YYYY--MM}\) discret.
  \item \textbf{Weekend / Jour férié (facultatif)} : indicateurs binaires.
  \item \textbf{Heure de la journée} (pour l’horaire) : 0–23 (one-hot ou sinus/cosinus).
\end{itemize}

