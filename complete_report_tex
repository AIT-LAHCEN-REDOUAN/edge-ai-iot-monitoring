\chapter{Évaluation et Simulation}
\onehalfspacing

\section*{Objectifs}
\begin{itemize}[leftmargin=1.5em]
  \item Évaluer \textbf{Baseline}, \textbf{MDP} et \textbf{RL} sur un horizon (p.\,ex. 168 h) avec \textbf{réplications} Monte‑Carlo.
  \item Calculer des \textbf{intervalles de confiance} (IC) sur l’énergie, le «\,discomfort\,» et le \textbf{coût global}.
  \item Étudier la \textbf{sensibilité} aux paramètres (\(\alpha\), coûts, pénalité de commutation).
\end{itemize}

\section*{Cadre d’évaluation}
Scénarios testés : \(\mathcal{C}=\{\text{Baseline (Always Normal)},\ \text{MDP},\ \text{RL}\}\).
Pour chaque réplication \(r\in\{1,\ldots,n\}\) et scénario \(c\in\mathcal{C}\), on simule une trajectoire de longueur \(T\) et on agrège, par heure \(t\) :
\[
  \text{energy}_{t}=\mathbb{E}[\text{kW}\mid s_t],\quad
  \text{action\_cost}_{t}=c(a_t),\quad
  \text{switch\_penalty}_{t}=\mathbf{1}_{a_t\ne a_{t-1}}\cdot \text{penalty},
\]
\[
  \text{discomfort}_{t}=\beta_H\cdot \Pr(H\mid s_t)+\beta_P\cdot \Pr(P\mid s_t),
\quad
  \text{overall}_{t}=\text{energy}_{t}+\text{action\_cost}_{t}+\text{switch\_penalty}_{t}.
\]
Les totaux sur l’horizon \(T\) sont sommés selon la métrique.

\section*{Intervalles de confiance (IC)}
Pour une métrique \(X\) (énergie, discomfort, overall) mesurée sur \(n\) réplications :
\[
  \bar{X}=\frac{1}{n}\sum_{r=1}^{n}X^{(r)},\quad
  \text{IC}_{1-\alpha}:\ \bar{X}\ \pm\ z_{1-\alpha/2}\,\frac{s_X}{\sqrt{n}},
\]
avec \(z_{0.975}\approx1.96\) pour 95 % et \(s_X\) l’écart‑type empirique des \(X^{(r)}\). Pour les \(\%\) d’économies, on applique la même formule sur \(\text{Savings\%}^{(r)}\).

\section*{Économies relatives}
\[
  \text{Savings\%}^{(r)}=\frac{E_{\text{base}}^{(r)}-E_{\text{scen}}^{(r)}}{E_{\text{base}}^{(r)}}\times 100.
\]
On rapporte \(\bar{\text{Savings\%}}\) et son IC normal.

\section*{Sensibilité}
Balayer des grilles (p.\,ex. \(\alpha\in\{0.1,0.2,0.3\}\), \(c(\text{Conserve})\), \(\text{penalty}\)) et enregistrer \(\text{Savings\%}\), \(\text{Overall}\), \(\text{Discomfort}\) pour comparer la robustesse des scénarios.

\section*{Mise en œuvre dans le projet}
\begin{itemize}[leftmargin=1.5em]
  \item \textbf{Entrées} : \(A,B,\pi_0\) normalisés ; \(\mathbb{E}[\text{kW}\mid s]\), coûts d’évaluation \(c_{\text{eval}}\), \(\text{penalty}\), \(\alpha\).
  \item \textbf{Scénarios} : Baseline (Normal), MDP (politique du Chap. 9), RL (politique du Chap. 10).
  \item \textbf{Réplications} : \(n\) indépendantes ; agrégation des métriques et calcul d’IC.
  \item \textbf{Sensibilité} : boucles sur \(\alpha\), \(c_{\text{eval}}(\text{Conserve})\), \(\text{penalty}\) ; résumé global.
\end{itemize}

\section*{Artefacts}
\begin{itemize}[leftmargin=1.5em]
  \item \texttt{evaluation\_summary\_alpha*\_cons*\_sw*.csv} : moyennes et ICs par scénario,
  \item \texttt{performance\_report\_alpha*\_cons*\_sw*.txt} : synthèse lisible (énergies, économies \%),
  \item \texttt{sensitivity\_summary.csv} : agrégat multi‑configurations,
  \item \texttt{sim\_trace\_baseline\_rep0.csv}, \texttt{sim\_trace\_mdp\_rep0.csv}, \texttt{sim\_trace\_rl\_rep0.csv} : traces de validation.
\end{itemize}

\section*{Exemple (résultats)}
Sur une configuration type (\(\alpha=0.2,\ c_{\text{eval}}(\text{Conserve})=0.05,\ \text{penalty}=0\), 168 h, \(n=50\)) :
\[
  E_{\text{Baseline}}\approx 187.99\ \text{kWh}\ [181.65,194.33],\quad
  E_{\text{MDP}}\approx 154.90\ \text{kWh}\ [150.34,159.46],\quad
  E_{\text{RL}}\approx 161.00\ \text{kWh}\ [156.54,165.46],
\]
\[
